#!/usr/bin/env python3
"""Capture and verify Q-Crate AXI4-Stream frames through DMAEngine."""
from __future__ import annotations

import argparse
import errno
import fcntl
import mmap
import os
import subprocess
import struct
import sys
from dataclasses import dataclass
from pathlib import Path


DEVICE = Path("/dev/qcrate-dma")
ABI_VERSION = 1
DMA_TRANS_NOERROR = 0
CAP_SG_CHAIN = 1 << 0
CAP_DSP_MODE = 1 << 1
CAP_TRIGGERED = 1 << 2

TRIGGER_SEEN = 1 << 0
FIRST_SAMPLE_TIME_VALID = 1 << 1

DSP_CONFIG = Path("/usr/share/qcrate/dsp/tone_1mhz.json")
DSP_TABLE_DIR = Path("/usr/share/qcrate/dsp")

INFO_STRUCT = struct.Struct("<8I")
CAPTURE_STRUCT = struct.Struct("<16I")
CAPS_STRUCT = struct.Struct("<8I")
CAPTURE_FRAMES_STRUCT = struct.Struct("<16I")
TRIGGERED_ARM_STRUCT = struct.Struct("<8I")
TRIGGERED_RESULT_STRUCT = struct.Struct("<14I2Q6I")
WORD_STRUCT = struct.Struct("<I")

IOC_NRBITS = 8
IOC_TYPEBITS = 8
IOC_SIZEBITS = 14
IOC_NRSHIFT = 0
IOC_TYPESHIFT = IOC_NRSHIFT + IOC_NRBITS
IOC_SIZESHIFT = IOC_TYPESHIFT + IOC_TYPEBITS
IOC_DIRSHIFT = IOC_SIZESHIFT + IOC_SIZEBITS
IOC_WRITE = 1
IOC_READ = 2


def ioctl_code(direction: int, number: int, size: int) -> int:
    return (
        (direction << IOC_DIRSHIFT)
        | (ord("Q") << IOC_TYPESHIFT)
        | (number << IOC_NRSHIFT)
        | (size << IOC_SIZESHIFT)
    )


IOC_GET_INFO = ioctl_code(IOC_READ, 0x00, INFO_STRUCT.size)
IOC_CAPTURE = ioctl_code(IOC_READ | IOC_WRITE, 0x01, CAPTURE_STRUCT.size)
IOC_GET_CAPS = ioctl_code(IOC_READ, 0x02, CAPS_STRUCT.size)
IOC_CAPTURE_FRAMES = ioctl_code(
    IOC_READ | IOC_WRITE, 0x03, CAPTURE_FRAMES_STRUCT.size
)
IOC_ARM_TRIGGERED = ioctl_code(IOC_WRITE, 0x04, TRIGGERED_ARM_STRUCT.size)
IOC_WAIT_TRIGGERED = ioctl_code(
    IOC_READ | IOC_WRITE, 0x05, TRIGGERED_RESULT_STRUCT.size
)
IOC_CANCEL_TRIGGERED = ioctl_code(0, 0x06, 0)


@dataclass(frozen=True)
class DeviceInfo:
    abi_version: int
    buffer_bytes: int
    max_transfer_bytes: int
    stream_word_bytes: int

    @property
    def max_frame_words(self) -> int:
        return min(self.buffer_bytes, self.max_transfer_bytes) // self.stream_word_bytes


@dataclass(frozen=True)
class DeviceCaps:
    abi_version: int
    feature_flags: int
    max_chain_frames: int

    @property
    def has_sg_chain(self) -> bool:
        return bool(self.feature_flags & CAP_SG_CHAIN)

    @property
    def has_dsp_mode(self) -> bool:
        return bool(self.feature_flags & CAP_DSP_MODE)

    @property
    def has_triggered_capture(self) -> bool:
        return bool(self.feature_flags & CAP_TRIGGERED)


@dataclass(frozen=True)
class CaptureResult:
    frame_length_words: int
    timeout_ms: int
    transferred_bytes: int
    residue_bytes: int
    dma_result: int
    stream_status: int
    completed_frames: int
    current_frame_id: int
    current_sample_index: int
    stall_cycles: int


@dataclass(frozen=True)
class CaptureFramesResult:
    frame_length_words: int
    frame_count: int
    timeout_ms: int
    transferred_bytes: int
    last_residue_bytes: int
    dma_result: int
    stream_status: int
    completed_frames: int
    current_frame_id: int
    current_sample_index: int
    stall_cycles: int


@dataclass(frozen=True)
class TriggeredResult:
    timeout_ms: int
    transferred_bytes: int
    last_residue_bytes: int
    dma_result: int
    stream_status: int
    completed_frames: int
    current_frame_id: int
    current_sample_index: int
    stall_cycles: int
    trigger_shot_id: int
    trigger_count: int
    missed_trigger_count: int
    timestamp_flags: int
    trigger_time: int
    first_sample_time: int


def get_info(fd: int) -> DeviceInfo:
    raw = bytearray(INFO_STRUCT.size)
    fcntl.ioctl(fd, IOC_GET_INFO, raw, True)
    values = INFO_STRUCT.unpack(raw)
    info = DeviceInfo(*values[:4])
    if info.abi_version != ABI_VERSION:
        raise RuntimeError(
            f"driver ABI {info.abi_version}, tool requires ABI {ABI_VERSION}"
        )
    if info.stream_word_bytes != WORD_STRUCT.size:
        raise RuntimeError(
            f"driver stream word is {info.stream_word_bytes} bytes, expected 4"
        )
    return info


def get_caps(fd: int) -> DeviceCaps:
    raw = bytearray(CAPS_STRUCT.size)
    try:
        fcntl.ioctl(fd, IOC_GET_CAPS, raw, True)
    except OSError as exc:
        if exc.errno == errno.ENOTTY:
            return DeviceCaps(ABI_VERSION, 0, 1)
        raise
    values = CAPS_STRUCT.unpack(raw)
    caps = DeviceCaps(*values[:3])
    if caps.abi_version != ABI_VERSION:
        raise RuntimeError(
            f"driver ABI {caps.abi_version}, tool requires ABI {ABI_VERSION}"
        )
    return caps


def request_capture(
    fd: int, words: int, timeout_ms: int, stream_mode: int = 0
) -> CaptureResult:
    values = [0] * 16
    values[0] = words
    values[1] = timeout_ms
    values[10] = stream_mode
    raw = bytearray(CAPTURE_STRUCT.pack(*values))
    fcntl.ioctl(fd, IOC_CAPTURE, raw, True)
    return CaptureResult(*CAPTURE_STRUCT.unpack(raw)[:10])


def request_capture_frames(
    fd: int, words: int, frames: int, timeout_ms: int, stream_mode: int = 0
) -> CaptureFramesResult:
    values = [0] * 16
    values[0] = words
    values[1] = frames
    values[2] = timeout_ms
    values[11] = stream_mode
    raw = bytearray(CAPTURE_FRAMES_STRUCT.pack(*values))
    fcntl.ioctl(fd, IOC_CAPTURE_FRAMES, raw, True)
    return CaptureFramesResult(*CAPTURE_FRAMES_STRUCT.unpack(raw)[:11])


def arm_triggered(
    fd: int, words: int, frames: int, stream_mode: int = 1
) -> None:
    values = [0] * 8
    values[0] = words
    values[1] = frames
    values[2] = stream_mode
    fcntl.ioctl(fd, IOC_ARM_TRIGGERED, TRIGGERED_ARM_STRUCT.pack(*values))


def wait_triggered(fd: int, timeout_ms: int) -> TriggeredResult:
    values = [0] * 22
    values[0] = timeout_ms
    raw = bytearray(TRIGGERED_RESULT_STRUCT.pack(*values))
    fcntl.ioctl(fd, IOC_WAIT_TRIGGERED, raw, True)
    unpacked = TRIGGERED_RESULT_STRUCT.unpack(raw)
    return TriggeredResult(*unpacked[:13], unpacked[14], unpacked[15])


def cancel_triggered(fd: int) -> None:
    try:
        fcntl.ioctl(fd, IOC_CANCEL_TRIGGERED)
    except OSError as exc:
        if exc.errno != errno.EINVAL:
            raise


def require_cancel_triggered(fd: int) -> None:
    fcntl.ioctl(fd, IOC_CANCEL_TRIGGERED)


def verify_pattern(buffer: mmap.mmap, words: int) -> None:
    for sample_index in range(words):
        actual = WORD_STRUCT.unpack_from(buffer, sample_index * WORD_STRUCT.size)[0]
        expected = sample_index & 0xFFFF
        if actual != expected:
            frame_id = actual >> 16
            sample = actual & 0xFFFF
            raise RuntimeError(
                f"word {sample_index}: expected 0x{expected:08x}, "
                f"got 0x{actual:08x} (frame={frame_id}, sample={sample})"
            )


def verify_frames(buffer: mmap.mmap, words: int, frames: int) -> None:
    for frame_id in range(frames):
        frame_offset = frame_id * words
        for sample_index in range(words):
            word_index = frame_offset + sample_index
            actual = WORD_STRUCT.unpack_from(
                buffer, word_index * WORD_STRUCT.size
            )[0]
            expected = ((frame_id & 0xFFFF) << 16) | (sample_index & 0xFFFF)
            if actual != expected:
                actual_frame = actual >> 16
                actual_sample = actual & 0xFFFF
                raise RuntimeError(
                    f"word {word_index}: expected 0x{expected:08x} "
                    f"(frame={frame_id}, sample={sample_index}), "
                    f"got 0x{actual:08x} "
                    f"(frame={actual_frame}, sample={actual_sample})"
                )


def verify_dsp(buffer: mmap.mmap, expected_words: list[int]) -> None:
    for word_index, expected in enumerate(expected_words):
        actual = WORD_STRUCT.unpack_from(
            buffer, word_index * WORD_STRUCT.size
        )[0]
        if actual != expected:
            actual_i = struct.unpack("<h", struct.pack("<H", actual & 0xFFFF))[0]
            actual_q = struct.unpack("<h", struct.pack("<H", actual >> 16))[0]
            expected_i = struct.unpack("<h", struct.pack("<H", expected & 0xFFFF))[0]
            expected_q = struct.unpack("<h", struct.pack("<H", expected >> 16))[0]
            raise RuntimeError(
                f"DSP word {word_index}: expected 0x{expected:08x} "
                f"(I={expected_i}, Q={expected_q}), got 0x{actual:08x} "
                f"(I={actual_i}, Q={actual_q})"
            )


def print_info(info: DeviceInfo, caps: DeviceCaps) -> None:
    print(f"ABI version        : {info.abi_version}")
    print(f"coherent buffer    : {info.buffer_bytes} bytes")
    print(f"DMA transfer limit : {info.max_transfer_bytes} bytes")
    print(f"stream word        : {info.stream_word_bytes} bytes")
    print(f"maximum frame      : {info.max_frame_words} words")
    print(f"SG frame chaining  : {'yes' if caps.has_sg_chain else 'no'}")
    print(f"maximum SG frames  : {caps.max_chain_frames}")
    print(f"DSP stream mode    : {'yes' if caps.has_dsp_mode else 'no'}")
    print(
        "triggered capture : "
        f"{'yes' if caps.has_triggered_capture else 'no'}"
    )
    if info.max_frame_words < 4096:
        print("NOTE: the current 14-bit AXI DMA length field limits frames to 4095 words")


def command_info(device: Path) -> None:
    fd = os.open(device, os.O_RDWR | os.O_CLOEXEC)
    try:
        print_info(get_info(fd), get_caps(fd))
    finally:
        os.close(fd)


def command_capture(
    device: Path,
    requested_words: int | None,
    timeout_ms: int,
    repeat: int,
    output: Path | None,
) -> None:
    fd = os.open(device, os.O_RDWR | os.O_CLOEXEC)
    try:
        info = get_info(fd)
        words = (
            min(4096, info.max_frame_words)
            if requested_words is None
            else requested_words
        )
        if words < 1 or words > info.max_frame_words:
            raise ValueError(
                f"--words must be between 1 and {info.max_frame_words}, got {words}"
            )
        if repeat < 1:
            raise ValueError(f"--repeat must be positive, got {repeat}")

        with mmap.mmap(
            fd,
            info.buffer_bytes,
            flags=mmap.MAP_SHARED,
            prot=mmap.PROT_READ,
        ) as buffer:
            result = None
            for iteration in range(1, repeat + 1):
                result = request_capture(fd, words, timeout_ms)
                if result.dma_result != DMA_TRANS_NOERROR:
                    raise RuntimeError(f"DMA result code {result.dma_result}")
                if result.transferred_bytes != words * WORD_STRUCT.size:
                    raise RuntimeError(
                        f"transferred {result.transferred_bytes} bytes, "
                        f"expected {words * WORD_STRUCT.size}"
                    )
                if result.residue_bytes:
                    raise RuntimeError(f"DMA residue is {result.residue_bytes} bytes")
                verify_pattern(buffer, words)
                if repeat > 1:
                    print(f"OK  capture {iteration}/{repeat}: {words} words")

            assert result is not None
            first = WORD_STRUCT.unpack_from(buffer, 0)[0]
            last = WORD_STRUCT.unpack_from(buffer, (words - 1) * 4)[0]
            print(f"PASS {repeat} capture(s), {words} words each; every word verified")
            print(f"first/last         : 0x{first:08x} / 0x{last:08x}")
            print(f"stream status      : 0x{result.stream_status:08x}")
            print(f"completed frames   : {result.completed_frames}")
            print(f"stall cycles       : {result.stall_cycles}")

            if output is not None:
                output.write_bytes(buffer[: words * WORD_STRUCT.size])
                print(f"wrote               : {output}")
    finally:
        os.close(fd)


def command_capture_frames(
    device: Path,
    requested_words: int | None,
    frames: int,
    timeout_ms: int,
    repeat: int,
    output: Path | None,
) -> None:
    fd = os.open(device, os.O_RDWR | os.O_CLOEXEC)
    try:
        info = get_info(fd)
        caps = get_caps(fd)
        if not caps.has_sg_chain:
            raise RuntimeError("driver or deployed AXI DMA does not support SG chaining")

        words = (
            min(4096, info.max_frame_words)
            if requested_words is None
            else requested_words
        )
        if words < 1 or words > info.max_frame_words:
            raise ValueError(
                f"--words must be between 1 and {info.max_frame_words}, got {words}"
            )
        max_buffer_frames = info.buffer_bytes // (words * WORD_STRUCT.size)
        max_frames = min(caps.max_chain_frames, max_buffer_frames)
        if frames < 2 or frames > max_frames:
            raise ValueError(
                f"--frames must be between 2 and {max_frames} for {words} words, "
                f"got {frames}"
            )
        if repeat < 1:
            raise ValueError(f"--repeat must be positive, got {repeat}")

        total_words = words * frames
        total_bytes = total_words * WORD_STRUCT.size
        with mmap.mmap(
            fd,
            info.buffer_bytes,
            flags=mmap.MAP_SHARED,
            prot=mmap.PROT_READ,
        ) as buffer:
            result = None
            for iteration in range(1, repeat + 1):
                result = request_capture_frames(fd, words, frames, timeout_ms)
                if result.dma_result != DMA_TRANS_NOERROR:
                    raise RuntimeError(f"DMA result code {result.dma_result}")
                if result.transferred_bytes != total_bytes:
                    raise RuntimeError(
                        f"transferred {result.transferred_bytes} bytes, "
                        f"expected {total_bytes}"
                    )
                if result.last_residue_bytes:
                    raise RuntimeError(
                        f"last descriptor residue is {result.last_residue_bytes} bytes"
                    )
                if result.completed_frames != frames:
                    raise RuntimeError(
                        f"stream completed {result.completed_frames} frames, "
                        f"expected {frames}"
                    )
                verify_frames(buffer, words, frames)
                if repeat > 1:
                    print(
                        f"OK  chain {iteration}/{repeat}: "
                        f"{frames} frames x {words} words"
                    )

            assert result is not None
            first = WORD_STRUCT.unpack_from(buffer, 0)[0]
            last = WORD_STRUCT.unpack_from(buffer, (total_words - 1) * 4)[0]
            print(
                f"PASS {repeat} chain(s), {frames} frames x {words} words; "
                "every word verified"
            )
            print(f"first/last         : 0x{first:08x} / 0x{last:08x}")
            print(f"stream status      : 0x{result.stream_status:08x}")
            print(f"completed frames   : {result.completed_frames}")
            print(f"final frame/sample : {result.current_frame_id} / "
                  f"{result.current_sample_index}")
            print(f"stall cycles       : {result.stall_cycles}")

            if output is not None:
                output.write_bytes(buffer[:total_bytes])
                print(f"wrote               : {output}")
    finally:
        os.close(fd)


def command_capture_dsp(
    device: Path,
    words: int,
    frames: int,
    timeout_ms: int,
    repeat: int,
    output: Path | None,
) -> None:
    try:
        from qcrate_dsp_reference import generate_words
    except ImportError as exc:
        raise RuntimeError("installed DSP reference module is unavailable") from exc

    fd = os.open(device, os.O_RDWR | os.O_CLOEXEC)
    try:
        info = get_info(fd)
        caps = get_caps(fd)
        if not caps.has_dsp_mode:
            raise RuntimeError("driver does not advertise DSP stream mode")
        if words < 1 or words > info.max_frame_words:
            raise ValueError(
                f"--words must be between 1 and {info.max_frame_words}, got {words}"
            )
        if frames < 1:
            raise ValueError(f"--frames must be positive, got {frames}")
        if frames > 1 and not caps.has_sg_chain:
            raise RuntimeError("multi-frame DSP capture requires SG chaining")
        max_buffer_frames = info.buffer_bytes // (words * WORD_STRUCT.size)
        max_frames = min(caps.max_chain_frames, max_buffer_frames)
        if frames > max_frames:
            raise ValueError(
                f"--frames must not exceed {max_frames} for {words} words"
            )
        if repeat < 1:
            raise ValueError(f"--repeat must be positive, got {repeat}")

        total_words = words * frames
        total_bytes = total_words * WORD_STRUCT.size
        expected_words = generate_words(DSP_CONFIG, DSP_TABLE_DIR, total_words)
        with mmap.mmap(
            fd,
            info.buffer_bytes,
            flags=mmap.MAP_SHARED,
            prot=mmap.PROT_READ,
        ) as buffer:
            result = None
            for iteration in range(1, repeat + 1):
                if frames == 1:
                    result = request_capture(fd, words, timeout_ms, stream_mode=1)
                    residue = result.residue_bytes
                else:
                    result = request_capture_frames(
                        fd, words, frames, timeout_ms, stream_mode=1
                    )
                    residue = result.last_residue_bytes
                if result.dma_result != DMA_TRANS_NOERROR:
                    raise RuntimeError(f"DMA result code {result.dma_result}")
                if result.transferred_bytes != total_bytes:
                    raise RuntimeError(
                        f"transferred {result.transferred_bytes} bytes, "
                        f"expected {total_bytes}"
                    )
                if residue:
                    raise RuntimeError(f"DMA residue is {residue} bytes")
                verify_dsp(buffer, expected_words)
                if repeat > 1:
                    print(
                        f"OK  DSP capture {iteration}/{repeat}: "
                        f"{frames} frame(s) x {words} words"
                    )

            assert result is not None
            first = WORD_STRUCT.unpack_from(buffer, 0)[0]
            last = WORD_STRUCT.unpack_from(buffer, (total_words - 1) * 4)[0]
            print(
                f"PASS {repeat} DSP capture(s), {frames} frame(s) x {words} words; "
                "every IQ word matched the bit-exact model"
            )
            print(f"first/last         : 0x{first:08x} / 0x{last:08x}")
            print(f"stream status      : 0x{result.stream_status:08x}")
            print(f"completed frames   : {result.completed_frames}")
            print(f"stall cycles       : {result.stall_cycles}")
            if output is not None:
                output.write_bytes(buffer[:total_bytes])
                print(f"wrote               : {output}")
    finally:
        os.close(fd)


def run_sequence_command(tool: Path, timeout_ms: int, command: str) -> None:
    argv = [str(tool), "--timeout-ms", str(timeout_ms), command]
    try:
        completed = subprocess.run(
            argv,
            check=False,
            timeout=timeout_ms / 1000.0 + 2.0,
        )
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"{' '.join(argv)} exceeded its timeout") from exc
    if completed.returncode:
        raise RuntimeError(
            f"{' '.join(argv)} exited with status {completed.returncode}"
        )


def command_capture_triggered(
    device: Path,
    words: int,
    frames: int,
    timeout_ms: int,
    sequence_timeout_ms: int,
    sequence_tool: Path,
    repeat: int,
    output: Path | None,
) -> None:
    try:
        from qcrate_dsp_reference import generate_words
    except ImportError as exc:
        raise RuntimeError("installed DSP reference module is unavailable") from exc

    fd = os.open(device, os.O_RDWR | os.O_CLOEXEC)
    try:
        info = get_info(fd)
        caps = get_caps(fd)
        if not caps.has_triggered_capture:
            raise RuntimeError("driver does not advertise triggered capture")
        if not caps.has_dsp_mode:
            raise RuntimeError("driver does not advertise DSP stream mode")
        if words < 1 or words > info.max_frame_words:
            raise ValueError(
                f"--words must be between 1 and {info.max_frame_words}, got {words}"
            )
        if frames < 1:
            raise ValueError(f"--frames must be positive, got {frames}")
        if frames > 1 and not caps.has_sg_chain:
            raise RuntimeError("multi-frame triggered capture requires SG chaining")
        max_buffer_frames = info.buffer_bytes // (words * WORD_STRUCT.size)
        max_frames = min(caps.max_chain_frames, max_buffer_frames)
        if frames > max_frames:
            raise ValueError(
                f"--frames must not exceed {max_frames} for {words} words"
            )
        if timeout_ms < 1 or sequence_timeout_ms < 1:
            raise ValueError("timeouts must be positive")
        if repeat < 1:
            raise ValueError(f"--repeat must be positive, got {repeat}")

        total_words = words * frames
        total_bytes = total_words * WORD_STRUCT.size
        expected_words = generate_words(DSP_CONFIG, DSP_TABLE_DIR, total_words)
        with mmap.mmap(
            fd,
            info.buffer_bytes,
            flags=mmap.MAP_SHARED,
            prot=mmap.PROT_READ,
        ) as buffer:
            result = None
            for iteration in range(1, repeat + 1):
                run_sequence_command(sequence_tool, sequence_timeout_ms, "arm")
                armed = False
                try:
                    arm_triggered(fd, words, frames, stream_mode=1)
                    armed = True
                    run_sequence_command(sequence_tool, sequence_timeout_ms, "start")
                    result = wait_triggered(fd, timeout_ms)
                    armed = False
                finally:
                    if armed:
                        cancel_triggered(fd)

                if result.dma_result != DMA_TRANS_NOERROR:
                    raise RuntimeError(f"DMA result code {result.dma_result}")
                if result.transferred_bytes != total_bytes:
                    raise RuntimeError(
                        f"transferred {result.transferred_bytes} bytes, "
                        f"expected {total_bytes}"
                    )
                if result.last_residue_bytes:
                    raise RuntimeError(
                        f"DMA residue is {result.last_residue_bytes} bytes"
                    )
                expected_flags = TRIGGER_SEEN | FIRST_SAMPLE_TIME_VALID
                if result.timestamp_flags != expected_flags:
                    raise RuntimeError(
                        f"timestamp flags 0x{result.timestamp_flags:x}, "
                        f"expected 0x{expected_flags:x}"
                    )
                if result.first_sample_time < result.trigger_time:
                    raise RuntimeError("first sample timestamp precedes trigger")
                verify_dsp(buffer, expected_words)
                if repeat > 1:
                    print(
                        f"OK  triggered shot {iteration}/{repeat}: "
                        f"shot_id={result.trigger_shot_id}, "
                        f"latency={result.first_sample_time - result.trigger_time} ticks"
                    )

            assert result is not None
            first = WORD_STRUCT.unpack_from(buffer, 0)[0]
            last = WORD_STRUCT.unpack_from(buffer, (total_words - 1) * 4)[0]
            latency = result.first_sample_time - result.trigger_time
            print(
                f"PASS {repeat} triggered DSP capture(s), "
                f"{frames} frame(s) x {words} words; every IQ word matched"
            )
            print(f"first/last         : 0x{first:08x} / 0x{last:08x}")
            print(f"shot ID            : {result.trigger_shot_id}")
            print(f"trigger time       : {result.trigger_time} ticks")
            print(f"first sample time  : {result.first_sample_time} ticks")
            print(f"trigger-to-sample  : {latency} ticks")
            print(f"trigger count      : {result.trigger_count}")
            print(f"missed triggers    : {result.missed_trigger_count}")
            print(f"stall cycles       : {result.stall_cycles}")
            if output is not None:
                output.write_bytes(buffer[:total_bytes])
                print(f"wrote               : {output}")
    finally:
        os.close(fd)


def command_test_trigger_cancel(device: Path, words: int) -> None:
    fd = os.open(device, os.O_RDWR | os.O_CLOEXEC)
    try:
        info = get_info(fd)
        caps = get_caps(fd)
        if not caps.has_triggered_capture:
            raise RuntimeError("driver does not advertise triggered capture")
        if words < 1 or words > info.max_frame_words:
            raise ValueError(
                f"--words must be between 1 and {info.max_frame_words}, got {words}"
            )

        arm_triggered(fd, words, 1, stream_mode=0)
        require_cancel_triggered(fd)

        with mmap.mmap(
            fd,
            info.buffer_bytes,
            flags=mmap.MAP_SHARED,
            prot=mmap.PROT_READ,
        ) as buffer:
            result = request_capture(fd, words, 1000)
            if result.dma_result != DMA_TRANS_NOERROR or result.residue_bytes:
                raise RuntimeError(
                    f"post-cancel capture failed: DMA={result.dma_result}, "
                    f"residue={result.residue_bytes}"
                )
            verify_pattern(buffer, words)
        print(
            f"PASS triggered arm/cancel and immediate recovery; "
            f"verified {words} words"
        )
    finally:
        os.close(fd)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--device", type=Path, default=DEVICE)
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("info", help="show the driver ABI and buffer limits")

    capture = subparsers.add_parser(
        "capture", help="capture one or more independent one-frame transfers"
    )
    capture.add_argument(
        "--words",
        type=int,
        help="words per frame (default: min(4096, hardware limit))",
    )
    capture.add_argument("--timeout-ms", type=int, default=1000)
    capture.add_argument(
        "--repeat",
        type=int,
        default=1,
        help="repeat independent one-frame captures",
    )
    capture.add_argument("--output", type=Path, help="write the final frame as binary")

    capture_frames = subparsers.add_parser(
        "capture-frames",
        help="capture one finite pre-armed scatter-gather frame chain",
    )
    capture_frames.add_argument(
        "--words",
        type=int,
        help="words per frame (default: min(4096, hardware limit))",
    )
    capture_frames.add_argument("--frames", type=int, default=8)
    capture_frames.add_argument("--timeout-ms", type=int, default=1000)
    capture_frames.add_argument(
        "--repeat",
        type=int,
        default=1,
        help="repeat complete multi-frame chains",
    )
    capture_frames.add_argument(
        "--output", type=Path, help="write the final complete chain as binary"
    )

    capture_dsp = subparsers.add_parser(
        "capture-dsp",
        help="capture STREAM_MODE=1 and verify exact complex DSP output",
    )
    capture_dsp.add_argument("--words", type=int, default=1024)
    capture_dsp.add_argument("--frames", type=int, default=4)
    capture_dsp.add_argument("--timeout-ms", type=int, default=2000)
    capture_dsp.add_argument("--repeat", type=int, default=1)
    capture_dsp.add_argument("--output", type=Path)

    capture_triggered = subparsers.add_parser(
        "capture-triggered",
        help="arm DMA, start the R5-owned sequence, and verify timed DSP data",
    )
    capture_triggered.add_argument("--words", type=int, default=1024)
    capture_triggered.add_argument("--frames", type=int, default=4)
    capture_triggered.add_argument("--timeout-ms", type=int, default=2000)
    capture_triggered.add_argument("--sequence-timeout-ms", type=int, default=2000)
    capture_triggered.add_argument(
        "--sequence-tool", type=Path, default=Path("/usr/bin/qcrate-sequence")
    )
    capture_triggered.add_argument("--repeat", type=int, default=1)
    capture_triggered.add_argument("--output", type=Path)

    cancel_test = subparsers.add_parser(
        "test-trigger-cancel",
        help="arm and cancel without a shot, then verify immediate recovery",
    )
    cancel_test.add_argument("--words", type=int, default=1024)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        if args.command == "info":
            command_info(args.device)
        elif args.command == "capture":
            command_capture(
                args.device,
                args.words,
                args.timeout_ms,
                args.repeat,
                args.output,
            )
        elif args.command == "capture-frames":
            command_capture_frames(
                args.device,
                args.words,
                args.frames,
                args.timeout_ms,
                args.repeat,
                args.output,
            )
        elif args.command == "capture-dsp":
            command_capture_dsp(
                args.device,
                args.words,
                args.frames,
                args.timeout_ms,
                args.repeat,
                args.output,
            )
        elif args.command == "capture-triggered":
            command_capture_triggered(
                args.device,
                args.words,
                args.frames,
                args.timeout_ms,
                args.sequence_timeout_ms,
                args.sequence_tool,
                args.repeat,
                args.output,
            )
        elif args.command == "test-trigger-cancel":
            command_test_trigger_cancel(args.device, args.words)
        else:
            raise AssertionError(args.command)
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
