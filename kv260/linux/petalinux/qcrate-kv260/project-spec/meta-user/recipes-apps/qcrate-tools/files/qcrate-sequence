#!/usr/bin/env python3
"""Load and control deterministic Q-Crate pulse sequences through R5 RPMsg."""
from __future__ import annotations

import argparse
import os
import select
import struct
import sys
import time
import zlib
from dataclasses import dataclass
from pathlib import Path


FPGA_FIRMWARE_NAME = "qcrate_kv260.bit.bin"
FPGA_FIRMWARE_NAME_PATH = "/proc/device-tree/fpga-region/firmware-name"
STREAM_CLOCK_HZ = 200_000_000
CONTROL_CLOCK_HZ = 100_000_000
CLOCK_RATE_TOLERANCE_HZ = 1_000
CLOCK_RATE_PATHS = (
    ("pl_clk0", "/sys/devices/platform/axi/axi:clocking0/set_rate", STREAM_CLOCK_HZ),
    ("pl_clk1", "/sys/devices/platform/axi/axi:clocking1/set_rate", CONTROL_CLOCK_HZ),
)

MAGIC = b"QSEQ"
FORMAT_VERSION = 1
MIN_EVENTS = 2
MAX_EVENTS = 128
OUTPUT_MASK = 0x3
HEADER = struct.Struct("<4sHHIIIIQ")
EVENT = struct.Struct("<QII")

RPMSG_SYSFS_CLASS = Path("/sys/class/rpmsg")
RPMSG_SERVICE_NAME = "qcrate-control"
RPMSG_MAGIC = 0x5152_4350
RPMSG_ABI_VERSION = 2
RPMSG_PAYLOAD_WORDS = 11
RPMSG_MESSAGE = struct.Struct("<IHHIIi11I")

CMD_SEQ_LOAD_BEGIN = 5
CMD_SEQ_LOAD_EVENT = 6
CMD_SEQ_LOAD_COMMIT = 7
CMD_SEQ_GET_STATUS = 8
CMD_SEQ_ARM = 9
CMD_SEQ_START = 10
CMD_SEQ_ABORT = 11
CMD_SEQ_RESET = 12

R5_STATUS_NAMES = {
    -1: "bad protocol magic",
    -2: "unsupported protocol ABI",
    -3: "bad payload length",
    -4: "unknown command",
    -5: "wrong PL device identity",
    -6: "scratch-register verification failed",
    -7: "operation is illegal in the current state",
    -8: "unexpected sequence event index",
    -9: "invalid sequence event",
    -10: "sequence CRC mismatch",
    -11: "PL event-memory verification failed",
    -12: "PL sequencer reported a fault",
    -13: "R5 timed out waiting for the PL sequencer",
}

STATUS_IDLE = 1 << 0
STATUS_VALIDATING = 1 << 1
STATUS_ARMED = 1 << 2
STATUS_BUSY = 1 << 3
STATUS_FAULTED = 1 << 4
STATUS_COMMAND_BUSY = 1 << 8
STATUS_MEMORY_LOCKED = 1 << 9
STATUS_LOAD_ACTIVE = 1 << 30
STATUS_COMMITTED = 1 << 31

FAULT_NAMES = {
    0: "none",
    1: "bad event count",
    2: "timestamps are not strictly increasing",
    3: "reserved output-state bits are nonzero",
    4: "reserved flags are nonzero",
    5: "event does not change output state",
    6: "final event does not restore safe state",
    7: "event-memory underflow",
    8: "event-memory response protocol error",
    9: "illegal command for current state",
}


class SequenceError(ValueError):
    """Raised when a sequence image or hardware state is invalid."""


class R5ServiceError(RuntimeError):
    """Raised when the R5 rejects a valid RPMsg transaction."""

    def __init__(self, status: int, payload: tuple[int, ...]) -> None:
        self.status = status
        self.payload = payload
        detail = R5_STATUS_NAMES.get(status, "unknown R5 service error")
        if status == -9 and len(payload) >= 2:
            fault = FAULT_NAMES.get(payload[1], "unknown validation fault")
            detail = f"event {payload[0]} failed validation: {fault}"
        elif status == -8 and len(payload) >= 2:
            detail = f"received event {payload[0]}, expected event {payload[1]}"
        elif status == -10 and len(payload) >= 2:
            detail = (
                f"sequence CRC mismatch: expected 0x{payload[0]:08x}, "
                f"R5 calculated 0x{payload[1]:08x}"
            )
        elif status == -12 and len(payload) == RPMSG_PAYLOAD_WORDS:
            fault_info = payload[4]
            fault_code = fault_info & 0xFF
            fault_event = (fault_info >> 16) & 0x7F
            fault = FAULT_NAMES.get(fault_code, "unknown hardware fault")
            detail = f"PL fault {fault_code} ({fault}) at event {fault_event}"
        super().__init__(f"R5 status {status}: {detail}")


@dataclass(frozen=True)
class SequenceEvent:
    timestamp: int
    output_state: int
    flags: int


@dataclass(frozen=True)
class SequenceImage:
    events: tuple[SequenceEvent, ...]
    payload: bytes
    crc32: int


@dataclass(frozen=True)
class SequenceStatus:
    raw: int
    event_count: int
    active_event: int
    completed_shots: int
    fault_code: int
    fault_event: int
    timebase: int
    start_time: int
    elapsed_ticks: int

    @property
    def idle(self) -> bool:
        return bool(self.raw & STATUS_IDLE)

    @property
    def validating(self) -> bool:
        return bool(self.raw & STATUS_VALIDATING)

    @property
    def armed(self) -> bool:
        return bool(self.raw & STATUS_ARMED)

    @property
    def busy(self) -> bool:
        return bool(self.raw & STATUS_BUSY)

    @property
    def faulted(self) -> bool:
        return bool(self.raw & STATUS_FAULTED)

    @property
    def command_busy(self) -> bool:
        return bool(self.raw & STATUS_COMMAND_BUSY)

    @property
    def memory_locked(self) -> bool:
        return bool(self.raw & STATUS_MEMORY_LOCKED)

    @property
    def load_active(self) -> bool:
        return bool(self.raw & STATUS_LOAD_ACTIVE)

    @property
    def committed(self) -> bool:
        return bool(self.raw & STATUS_COMMITTED)


class RpmsgTransport:
    def __init__(self, device: Path, timeout_ms: int) -> None:
        self._fd = os.open(device, os.O_RDWR | os.O_CLOEXEC)
        self._timeout_ms = timeout_ms
        self._transaction_id = (time.monotonic_ns() ^ os.getpid()) & 0xFFFF_FFFF

    def close(self) -> None:
        os.close(self._fd)

    def __enter__(self) -> "RpmsgTransport":
        return self

    def __exit__(self, _exc_type, _exc, _traceback) -> None:
        self.close()

    def exchange(self, command: int, payload: tuple[int, ...] = ()) -> tuple[int, ...]:
        if len(payload) > RPMSG_PAYLOAD_WORDS:
            raise ValueError("RPMsg payload exceeds eleven words")
        if any(value < 0 or value > 0xFFFF_FFFF for value in payload):
            raise ValueError("RPMsg payload words must be unsigned 32-bit values")

        self._transaction_id = (self._transaction_id + 1) & 0xFFFF_FFFF
        padded = payload + (0,) * (RPMSG_PAYLOAD_WORDS - len(payload))
        request = RPMSG_MESSAGE.pack(
            RPMSG_MAGIC,
            RPMSG_ABI_VERSION,
            command,
            self._transaction_id,
            len(payload),
            0,
            *padded,
        )
        if os.write(self._fd, request) != len(request):
            raise OSError("short RPMsg request write")

        poller = select.poll()
        poller.register(self._fd, select.POLLIN)
        events = poller.poll(self._timeout_ms)
        if not events:
            raise TimeoutError(
                f"R5 response timed out after {self._timeout_ms} ms"
            )
        if not (events[0][1] & select.POLLIN):
            raise OSError(f"RPMsg endpoint poll error 0x{events[0][1]:x}")

        contents = os.read(self._fd, RPMSG_MESSAGE.size)
        if len(contents) != RPMSG_MESSAGE.size:
            raise OSError(
                f"short RPMsg response: {len(contents)} of {RPMSG_MESSAGE.size} bytes"
            )
        unpacked = RPMSG_MESSAGE.unpack(contents)
        magic, abi, response_command, transaction_id, words, status = unpacked[:6]
        if (
            magic != RPMSG_MAGIC
            or abi != RPMSG_ABI_VERSION
            or response_command != command
            or transaction_id != self._transaction_id
            or words > RPMSG_PAYLOAD_WORDS
        ):
            raise RuntimeError("invalid R5 RPMsg response header")
        response_payload = tuple(unpacked[6:6 + words])
        if status != 0:
            raise R5ServiceError(status, response_payload)
        return response_payload


def read_text(path: str | Path) -> str:
    with open(path, "r", encoding="ascii") as stream:
        return stream.read().rstrip("\0\n")


def discover_endpoint() -> Path:
    try:
        candidates = sorted(RPMSG_SYSFS_CLASS.glob("rpmsg*"))
    except OSError as exc:
        raise RuntimeError("cannot inspect the RPMsg class") from exc
    for candidate in candidates:
        try:
            if read_text(candidate / "name") == RPMSG_SERVICE_NAME:
                return Path("/dev") / candidate.name
        except OSError:
            continue
    raise RuntimeError(f"{RPMSG_SERVICE_NAME} RPMsg endpoint is unavailable")


def preflight_platform() -> None:
    try:
        firmware_name = read_text(FPGA_FIRMWARE_NAME_PATH)
    except OSError as exc:
        raise RuntimeError(
            "Q-Crate FPGA ownership cannot be verified; "
            "qcrate-pl-load.service is not ready"
        ) from exc
    if firmware_name != FPGA_FIRMWARE_NAME:
        raise RuntimeError(
            f"FPGA region contains {firmware_name!r}, expected {FPGA_FIRMWARE_NAME!r}"
        )
    for clock_name, path, expected in CLOCK_RATE_PATHS:
        try:
            actual = int(read_text(path), 10)
        except (OSError, ValueError) as exc:
            raise RuntimeError(f"cannot verify {clock_name} at {path}") from exc
        if abs(actual - expected) > CLOCK_RATE_TOLERANCE_HZ:
            raise RuntimeError(
                f"{clock_name} is {actual} Hz, expected {expected} Hz "
                f"(+/- {CLOCK_RATE_TOLERANCE_HZ} Hz)"
            )


def decode_image(contents: bytes) -> SequenceImage:
    if len(contents) < HEADER.size:
        raise SequenceError("sequence image is shorter than its header")
    (
        magic,
        version,
        header_size,
        event_count,
        event_size,
        tick_hz,
        expected_crc,
        reserved,
    ) = HEADER.unpack_from(contents)
    if magic != MAGIC:
        raise SequenceError("wrong sequence magic")
    if version != FORMAT_VERSION:
        raise SequenceError(f"unsupported sequence format version {version}")
    if header_size != HEADER.size or event_size != EVENT.size:
        raise SequenceError("incompatible header or event-record size")
    if tick_hz != STREAM_CLOCK_HZ:
        raise SequenceError(
            f"sequence tick rate is {tick_hz} Hz, expected {STREAM_CLOCK_HZ} Hz"
        )
    if reserved != 0:
        raise SequenceError("reserved header field is nonzero")
    if not MIN_EVENTS <= event_count <= MAX_EVENTS:
        raise SequenceError(
            f"event count must be between {MIN_EVENTS} and {MAX_EVENTS}"
        )
    expected_size = header_size + event_count * event_size
    if len(contents) != expected_size:
        raise SequenceError(
            f"image is {len(contents)} bytes; expected exactly {expected_size}"
        )

    payload = contents[header_size:]
    actual_crc = zlib.crc32(payload) & 0xFFFF_FFFF
    if actual_crc != expected_crc:
        raise SequenceError(
            f"payload CRC mismatch: expected 0x{expected_crc:08x}, "
            f"got 0x{actual_crc:08x}"
        )

    events = tuple(
        SequenceEvent(*EVENT.unpack_from(payload, index * EVENT.size))
        for index in range(event_count)
    )
    previous_timestamp: int | None = None
    previous_state = 0
    for index, event in enumerate(events):
        if previous_timestamp is not None and event.timestamp <= previous_timestamp:
            raise SequenceError(f"event {index} timestamp is not strictly increasing")
        if event.output_state & ~OUTPUT_MASK:
            raise SequenceError(f"event {index} uses reserved output-state bits")
        if event.flags:
            raise SequenceError(f"event {index} has nonzero reserved flags")
        if event.output_state == previous_state:
            raise SequenceError(f"event {index} does not change output state")
        previous_timestamp = event.timestamp
        previous_state = event.output_state
    if previous_state != 0:
        raise SequenceError("final event does not restore both outputs low")
    return SequenceImage(events, payload, actual_crc)


def status_from_payload(payload: tuple[int, ...]) -> SequenceStatus:
    if len(payload) != 11:
        raise RuntimeError(f"R5 returned {len(payload)} status words, expected 11")
    fault_info = payload[4]
    return SequenceStatus(
        raw=payload[0],
        event_count=payload[1],
        active_event=payload[2],
        completed_shots=payload[3],
        fault_code=fault_info & 0xFF,
        fault_event=(fault_info >> 16) & 0x7F,
        timebase=(payload[6] << 32) | payload[5],
        start_time=(payload[8] << 32) | payload[7],
        elapsed_ticks=(payload[10] << 32) | payload[9],
    )


def read_status(transport) -> SequenceStatus:
    return status_from_payload(transport.exchange(CMD_SEQ_GET_STATUS))


def state_name(status: SequenceStatus) -> str:
    states = (
        (status.faulted, "faulted"),
        (status.busy, "busy"),
        (status.armed, "armed"),
        (status.validating, "validating"),
        (status.idle, "idle"),
    )
    return next((name for active, name in states if active), "unknown")


def print_status(status: SequenceStatus) -> None:
    print(f"state              : {state_name(status)}")
    print(f"status raw         : 0x{status.raw:08x}")
    print(f"R5 load active     : {'yes' if status.load_active else 'no'}")
    print(f"R5 table committed : {'yes' if status.committed else 'no'}")
    print(f"command busy       : {'yes' if status.command_busy else 'no'}")
    print(f"event memory locked: {'yes' if status.memory_locked else 'no'}")
    print(f"event count        : {status.event_count}")
    print(f"active event       : {status.active_event}")
    print(f"completed shots    : {status.completed_shots}")
    print(f"timebase           : {status.timebase} ticks")
    print(f"start time         : {status.start_time} ticks")
    print(f"elapsed            : {status.elapsed_ticks} ticks")
    fault_name = FAULT_NAMES.get(status.fault_code, "unknown fault")
    print(
        f"fault              : {status.fault_code} ({fault_name}), "
        f"event {status.fault_event}"
    )


def wait_for(
    transport,
    predicate,
    *,
    timeout_ms: int,
    description: str,
    fail_on_fault: bool = True,
) -> SequenceStatus:
    deadline = time.monotonic() + timeout_ms / 1000.0
    while True:
        status = read_status(transport)
        if fail_on_fault and status.faulted:
            fault_name = FAULT_NAMES.get(status.fault_code, "unknown fault")
            raise RuntimeError(
                f"hardware fault {status.fault_code} ({fault_name}) "
                f"at event {status.fault_event}"
            )
        if predicate(status):
            return status
        if time.monotonic() >= deadline:
            raise TimeoutError(
                f"timed out after {timeout_ms} ms waiting for {description}; "
                f"last state was {state_name(status)} (0x{status.raw:08x})"
            )
        time.sleep(0.001)


def load_image(transport, image: SequenceImage) -> None:
    status = read_status(transport)
    if not status.idle or status.memory_locked or status.faulted:
        raise RuntimeError(
            f"event memory is not writable: state={state_name(status)}, "
            f"locked={'yes' if status.memory_locked else 'no'}"
        )

    response = transport.exchange(
        CMD_SEQ_LOAD_BEGIN, (len(image.events), image.crc32)
    )
    if response != (len(image.events), image.crc32):
        raise RuntimeError("R5 load-begin acknowledgement mismatch")

    for index, event in enumerate(image.events):
        response = transport.exchange(
            CMD_SEQ_LOAD_EVENT,
            (
                index,
                event.timestamp & 0xFFFF_FFFF,
                event.timestamp >> 32,
                event.output_state,
                event.flags,
            ),
        )
        if response != (index,):
            raise RuntimeError(f"R5 event {index} acknowledgement mismatch")

    response = transport.exchange(CMD_SEQ_LOAD_COMMIT)
    if response != (len(image.events), image.crc32):
        raise RuntimeError("R5 load-commit acknowledgement mismatch")
    status = read_status(transport)
    if not status.committed or status.event_count != len(image.events):
        raise RuntimeError("R5 did not commit the complete event table")
    print(
        f"PASS R5 loaded and committed {len(image.events)} events "
        f"({len(image.payload)} bytes, CRC 0x{image.crc32:08x})"
    )


def command_arm(transport, timeout_ms: int, external_trigger: bool) -> None:
    status = read_status(transport)
    if not status.committed:
        raise RuntimeError("R5 has no committed sequence table")
    status = status_from_payload(
        transport.exchange(CMD_SEQ_ARM, (int(external_trigger),))
    )
    if not status.armed:
        status = wait_for(
            transport,
            lambda value: value.armed,
            timeout_ms=timeout_ms,
            description="R5-mediated arm-time validation",
        )
    print(f"PASS R5 armed {status.event_count} events")


def command_start(transport, timeout_ms: int) -> SequenceStatus:
    status = read_status(transport)
    if not status.armed or not status.committed:
        raise RuntimeError(f"sequencer is {state_name(status)}, not R5-owned and armed")
    completed_before = status.completed_shots
    status = status_from_payload(transport.exchange(CMD_SEQ_START))
    if status.completed_shots == completed_before:
        status = wait_for(
            transport,
            lambda value: value.completed_shots != completed_before,
            timeout_ms=timeout_ms,
            description="sequence completion reported by R5",
        )
    if not status.idle or status.memory_locked:
        status = wait_for(
            transport,
            lambda value: value.idle and not value.memory_locked,
            timeout_ms=timeout_ms,
            description="R5-observed event-memory release",
        )
    print(
        f"PASS R5 shot {status.completed_shots}; start={status.start_time}, "
        f"elapsed={status.elapsed_ticks} ticks"
    )
    return status


def command_abort(transport, _timeout_ms: int) -> None:
    status = status_from_payload(transport.exchange(CMD_SEQ_ABORT))
    if not status.idle or status.memory_locked:
        raise RuntimeError("R5 abort did not return the sequencer to idle")
    print("PASS R5 abort returned the sequencer to idle")


def command_reset(transport, _timeout_ms: int) -> SequenceStatus:
    before = read_status(transport)
    status = status_from_payload(transport.exchange(CMD_SEQ_RESET))
    if not status.idle or status.memory_locked or status.fault_code != 0:
        raise RuntimeError("R5 reset did not clear the sequencer state")
    if status.timebase <= before.timebase:
        status = read_status(transport)
    if status.timebase <= before.timebase:
        raise RuntimeError("shared timebase did not advance across sequencer reset")
    print("PASS R5 reset sequencer state; shared timebase was not reset")
    return status


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--device",
        type=Path,
        help="rpmsg_char device; default: discover the qcrate-control endpoint",
    )
    parser.add_argument(
        "--timeout-ms", type=int, default=2000, help="RPMsg and state timeout"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("status", help="read R5-mediated sequencer status")
    load_parser = subparsers.add_parser("load", help="validate and upload a .qseq")
    load_parser.add_argument("image", type=Path)
    arm_parser = subparsers.add_parser("arm", help="ask R5 to validate and arm")
    arm_parser.add_argument("--external-trigger", action="store_true")
    subparsers.add_parser("start", help="ask R5 to start and wait for completion")
    subparsers.add_parser("abort", help="ask R5 to abort the active sequence")
    subparsers.add_parser("reset", help="ask R5 to soft-reset sequencer state")
    test_parser = subparsers.add_parser(
        "test", help="R5-load, arm, start, and verify one completed shot"
    )
    test_parser.add_argument("image", type=Path)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.timeout_ms <= 0:
        print("qcrate-sequence: --timeout-ms must be positive", file=sys.stderr)
        return 2

    try:
        image = None
        if args.command in {"load", "test"}:
            image = decode_image(args.image.read_bytes())
        preflight_platform()
        device = args.device if args.device is not None else discover_endpoint()
        with RpmsgTransport(device, args.timeout_ms) as transport:
            if args.command == "status":
                print_status(read_status(transport))
            elif args.command == "load":
                load_image(transport, image)
            elif args.command == "arm":
                command_arm(transport, args.timeout_ms, args.external_trigger)
            elif args.command == "start":
                command_start(transport, args.timeout_ms)
            elif args.command == "abort":
                command_abort(transport, args.timeout_ms)
            elif args.command == "reset":
                command_reset(transport, args.timeout_ms)
            elif args.command == "test":
                command_reset(transport, args.timeout_ms)
                load_image(transport, image)
                timebase_before = read_status(transport).timebase
                command_arm(transport, args.timeout_ms, False)
                final_status = command_start(transport, args.timeout_ms)
                if final_status.timebase <= timebase_before:
                    raise RuntimeError("shared timebase did not advance")
                print("PASS R5-owned sequencer control-path acceptance")
            else:
                raise AssertionError(f"unhandled command {args.command}")
    except (OSError, RuntimeError, SequenceError, TimeoutError, ValueError) as exc:
        print(f"qcrate-sequence: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
